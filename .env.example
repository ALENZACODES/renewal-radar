# Optional: AI is disabled unless credentials are provided. Never put these in frontend files.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
TAVILY_API_KEY=
# Production: protect with a reverse proxy, TLS, authentication, monitoring and managed secrets.
DATABASE_URL=sqlite:///./renewal_radar.db
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_ENV=development
MAX_PDF_MB=8

# Production API gate (min 24 chars). Required when APP_ENV=production.
# Send as header: X-Api-Key: <value>
RR_API_ACCESS_KEY=
# Use APP_ENV=production to fail closed if the key is missing.
